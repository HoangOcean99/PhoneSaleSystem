# =======================================================
# CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU (PHONE SALE SYSTEM)
# =======================================================
# Hướng dẫn:
# 1. Sao chép file này và đổi tên thành .env
# 2. Điền chuỗi kết nối phù hợp với máy của bạn
# 3. File .env đã được cấu hình trong .gitignore nên KHÔNG bị commit lên Git

# CÁCH 1: Cấu hình trực tiếp chuỗi kết nối (Khuyên dùng)
DB_CONNECTION_STRING="Server=.\\SQLEXPRESS;Database=PhoneSaleDB;Trusted_Connection=True;TrustServerCertificate=True;"

# CÁCH 2: Nếu sử dụng tài khoản SQL Server Authentication (sa):
# DB_CONNECTION_STRING="Server=.\\SQLEXPRESS;Database=PhoneSaleDB;User Id=sa;Password=your_password;TrustServerCertificate=True;"

# CÁCH 3: Cấu hình từng thông số riêng lẻ:
# DB_SERVER=.\\SQLEXPRESS
# DB_DATABASE=PhoneSaleDB
# DB_USER=sa
# DB_PASSWORD=your_password

